# Server-side Vercel environment variables (never expose the service key in browser code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_SECRET=generate-a-long-random-secret
OPENAI_API_KEY=your-openai-api-key
CLARA_OPENAI_MODEL=gpt-5.6-terra
CLARA_REASONING_EFFORT=low
CLARA_MAX_OUTPUT_TOKENS=1800
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-strong-password
CUSTOMER_USERNAME=your-customer-username
CUSTOMER_PASSWORD=use-a-strong-customer-password
