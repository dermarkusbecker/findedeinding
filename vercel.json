{
  "cleanUrls": false,
  "functions": {
    "api/*.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/zugang", "destination": "/login.html" },
    { "source": "/kunden-login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/portal", "destination": "/api/portal" }
  ],
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": false },
    { "source": "/portal.html", "destination": "/portal", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
